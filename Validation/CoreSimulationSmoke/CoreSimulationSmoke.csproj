<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Assets\Game\Scripts\Domain\**\*.cs"
             Link="Shared\Domain\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Game\Scripts\Application\**\*.cs"
             Link="Shared\Application\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
